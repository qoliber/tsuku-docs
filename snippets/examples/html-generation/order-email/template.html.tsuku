<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your order #@html(order.increment_id)</title>
  <style>
    @@media (max-width: 480px) {
      .card { padding: 20px !important; }
      .sku { display: none !important; }
    }
  </style>
</head>
<body style="margin:0; padding:24px 12px; background:#f4f4f5; font:15px/1.5 Arial, Helvetica, sans-serif; color:#18181b;">
  <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; margin:0 auto; padding:32px; background:#ffffff; border-radius:8px;">
    <tr>
      <td>
        <h1 style="margin:0 0 8px; font-size:22px;">Thanks for your order, @html(order.customer_firstname)!</h1>
        <p style="margin:0 0 24px; color:#52525b;">Order #@html(order.increment_id) · @date("F j, Y", order.created_at)</p>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
          @for(order.items as item)
          <tr>
            <td style="padding:8px 0; border-bottom:1px solid #e4e4e7;">
              @html(item.name)
              <span class="sku" style="color:#71717a; font-size:13px;">· @html(item.sku)</span>
            </td>
            <td style="padding:8px 0; border-bottom:1px solid #e4e4e7; text-align:right; white-space:nowrap;">{item.qty} × €@number(item.price, 2)</td>
          </tr>
          @end
          <tr>
            <td style="padding:8px 0;">Shipping (@html(order.shipping_method))</td>
            <td style="padding:8px 0; text-align:right;">
              @if(order.shipping_amount > 0)
              €@number(order.shipping_amount, 2)
              @else
              Free
              @end
            </td>
          </tr>
          <tr>
            <td style="padding:8px 0; font-weight:bold;">Total</td>
            <td style="padding:8px 0; font-weight:bold; text-align:right;">€@number(order.grand_total, 2)</td>
          </tr>
        </table>
        @if(order.tracking_url)
        <p style="margin:24px 0;">
          <a href="@html(order.tracking_url)" style="display:inline-block; padding:10px 18px; background:#3451b2; color:#ffffff; border-radius:6px; text-decoration:none;">Track your parcel</a>
        </p>
        @end
        <p style="margin:24px 0 0; color:#52525b; font-size:13px;">
          Shipping to @html(order.shipping_address.name), @html(order.shipping_address.street), @html(order.shipping_address.city).<br>
          Questions? Reply to this email or write to support@@shop.example.com.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
