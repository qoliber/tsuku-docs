# {app.env} settings, generated @date("Y-m-d", generated_at). Do not edit by hand.
APP_ENV={app.env}
APP_DEBUG=@?{app.debug "true" : "false"}
APP_URL={app.url}

DB_HOST={db.host}
DB_PORT={db.port}
DB_DATABASE={db.name}

CACHE_DRIVER={cache.driver}
@match(cache.driver)
@case("redis")
REDIS_HOST={cache.host}
REDIS_PORT={cache.port}
@case("memcached")
MEMCACHED_HOST={cache.host}
@end

MAIL_FROM_ADDRESS={mail.address}
MAIL_FROM_NAME="{mail.name}"
