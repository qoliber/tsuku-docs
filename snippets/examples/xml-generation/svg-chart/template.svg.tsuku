<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {chart.width} {chart.height}" width="{chart.width}" height="{chart.height}" role="img" aria-label="@xml(chart.title)">
  <title>@xml(chart.title)</title>
  <line x1="0" y1="{chart.baseline}" x2="{chart.width}" y2="{chart.baseline}" stroke="#a1a1aa"/>
  @for(bars as bar)
  <g>
    <rect x="{bar.x}" y="{bar.y}" width="{chart.bar_width}" height="{bar.height}" rx="3" fill="@?{bar.best "#3451b2" : "#8ea2e8"}"/>
    <text x="{bar.center}" y="{bar.value_y}" text-anchor="middle" font-size="11" fill="#52525b">@number(bar.value, 0)</text>
    <text x="{bar.center}" y="{chart.label_y}" text-anchor="middle" font-size="12" fill="#52525b">@xml(bar.label)</text>
  </g>
  @end
</svg>
